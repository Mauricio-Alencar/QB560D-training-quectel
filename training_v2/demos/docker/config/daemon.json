{
  "hosts": ["unix:///run/qb560d-docker-demo/docker.sock"],
  "data-root": "/opt/qb560d-docker-demo/data",
  "exec-root": "/run/qb560d-docker-demo/exec",
  "pidfile": "/run/qb560d-docker-demo/dockerd.pid",
  "storage-driver": "overlay2",
  "features": {"containerd-snapshotter": false},
  "bridge": "none",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-masq": false,
  "userland-proxy": false,
  "log-driver": "json-file",
  "log-opts": {"max-size": "5m", "max-file": "2"}
}
