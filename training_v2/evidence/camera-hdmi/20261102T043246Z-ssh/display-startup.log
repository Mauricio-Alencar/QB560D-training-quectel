[Unit]
Description=Init-display Service
SourcePath=/etc/initscripts/init_qti_display
Requires=leprop.service persist-prop.service
After=leprop.service persist-prop.service

[Service]
Restart=no
Type=simple
RemainAfterExit=yes
ExecStart=/etc/initscripts/init_qti_display start
ExecStop=/etc/initscripts/init_qti_display stop

[Install]
WantedBy=multi-user.target
ExecStart={ path=/etc/initscripts/init_qti_display ; argv[]=/etc/initscripts/init_qti_display start ; ignore_errors=no ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
FragmentPath=/etc/systemd/system/init_display.service
