USB TREE
/:  Bus 03.Port 1: Dev 1, Class=root_hub, Driver=xhci-hcd/0p, 5000M
/:  Bus 02.Port 1: Dev 1, Class=root_hub, Driver=xhci-hcd/1p, 480M
/:  Bus 01.Port 1: Dev 1, Class=root_hub, Driver=dummy_hcd/1p, 480M

ROLE SWITCHES
/sys/class/usb_role/a600000.ssusb-role-switch/role: none
/sys/class/typec/port0/data_role: host [device]

