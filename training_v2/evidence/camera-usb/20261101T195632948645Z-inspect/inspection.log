idProduct=0002
product=Dummy host controller
authorized=1
/sys/bus/usb/devices/usb2 idVendor=1d6b
idProduct=0002
product=xHCI Host Controller
authorized=1
/sys/bus/usb/devices/usb3 idVendor=1d6b
idProduct=0003
product=xHCI Host Controller
authorized=1

